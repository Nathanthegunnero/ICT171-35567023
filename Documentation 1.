      />
      <button
        type="submit"
        className="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
      >
        Search
      </button>
    </form>
  );
}

export default LocationSearch;
```

**Explanation:**  
A controlled form component that captures user input and triggers a search. The parent component handles the actual API call using the query (which can be expanded with a geocoding step for city names to lat/long).


