### C.3 Location Search Component (Simplified)

```jsx
// src/components/LocationSearch.jsx
import React, { useState } from 'react';

function LocationSearch({ onSearch }) {
  const [query, setQuery] = useState('');

  const handleSubmit = (e) => {
    e.preventDefault();
    if (query.trim()) {
      onSearch(query.trim());
      setQuery('');
    }
  };

  return (
    <form onSubmit={handleSubmit} className="flex gap-2 mb-6">
      <input
        type="text"
        value={query}
        onChange={(e) => setQuery(e.target.value)}
        placeholder="Search city or postcode (e.g. Perth, 6000)"
